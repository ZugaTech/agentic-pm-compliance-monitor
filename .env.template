# ============================================================
# BNH Agentic PM Compliance Monitor — Environment Template
# Copy to .env and fill in your values. Never commit .env.
# ============================================================

# Required — Fireworks AI API key
FIREWORKS_API_KEY=your_key_here

# Model
FIREWORKS_MODEL_ID=accounts/fireworks/models/kimi-k2-7

# LLM Behaviour
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=250
LLM_TOP_P=0.85
LLM_FREQUENCY_PENALTY=0.1
LLM_PRESENCE_PENALTY=0.05

# Confidence Threshold (0.0–1.0). Below this, fall back to deterministic rules.
LLM_CONFIDENCE_THRESHOLD=0.75

# Performance
LLM_REQUEST_TIMEOUT_MS=5000
LLM_LOG_LEVEL=info
